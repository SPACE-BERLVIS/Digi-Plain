---
const { article } = Astro.props;
const d = article.data;
const coverImage = d.featuredImage || `/covers/${d.slug}.svg`;
const coverImageAlt = d.featuredImageAlt || `DigiPlain cover for ${d.title}`;
---
<a class="card article-card" href={`/${d.category}/${d.slug}/`}>
  <div class="article-card-image">
    <img src={coverImage} alt={coverImageAlt} loading="lazy" />
  </div>
  <div class="article-card-content">
    <div class="meta">{d.topic}</div>
    <h3>{d.title}</h3>
    <p>{d.description}</p>
    <time datetime={d.updatedAt.toISOString()}>Updated {d.updatedAt.toLocaleDateString('en-NG', { month:'short', day:'numeric', year:'numeric' })}</time>
  </div>
</a>
