---
import BaseLayout from './BaseLayout.astro';
const { article } = Astro.props;
const d = article.data;
const site = Astro.site?.toString().replace(/\/$/, '') || 'https://digiplain.invalid';
const url = `${site}/${d.category}/${d.slug}/`;
const coverImage = d.featuredImage || `/covers/${d.slug}.svg`;
const coverImageAlt = d.featuredImageAlt || `DigiPlain cover for ${d.title}`;
const featuredImageUrl = new URL(coverImage, site).toString();
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  datePublished: d.publishedAt.toISOString(),
  dateModified: d.updatedAt.toISOString(),
  mainEntityOfPage: url,
  image: [featuredImageUrl],
  author: { '@type': 'Organization', name: d.author },
  publisher: { '@type': 'Organization', name: 'DigiPlain', url: site }
};
---
<BaseLayout
  title={`${d.title} | DigiPlain`}
  description={d.description}
  canonical={url}
  image={coverImage}
  imageAlt={coverImageAlt}
  type="article"
  structuredData={schema}
>
  <header class="article-header container">
    <div class="breadcrumbs"><a href="/">Home</a><span>›</span><a href={`/${d.category}/`}>{d.category}</a><span>›</span>{d.topic}</div>
    <div class="eyebrow">{d.topic}</div>
    <h1>{d.title}</h1>
    <p class="article-dek">{d.description}</p>
    <div class="article-meta">
      <span>By {d.author}</span>
      <span>Published {d.publishedAt.toLocaleDateString('en-NG', { day:'numeric', month:'long', year:'numeric' })}</span>
      <span>Updated {d.updatedAt.toLocaleDateString('en-NG', { day:'numeric', month:'long', year:'numeric' })}</span>
      {d.verifiedAt && <span>Verified {d.verifiedAt.toLocaleDateString('en-NG', { day:'numeric', month:'long', year:'numeric' })}</span>}
    </div>
  </header>
  <figure class="article-featured-image">
    <img src={coverImage} alt={coverImageAlt} loading="eager" fetchpriority="high" />
  </figure>
  <div class="article-shell">
    <article class="article-body">
      <slot />
      <div class="ad-slot" aria-label="Advertisement placeholder">Advertisement</div>
      <div class="answer-box">
        <strong>Was this guide helpful?</strong>
        <p class="muted" style="margin:6px 0 0">If a step has changed, tell us through the corrections page. We review practical guides for freshness.</p>
      </div>
    </article>
    <aside class="article-sidebar">
      <div class="sidebar-box">
        <strong>More on DigiPlain</strong>
        <a href={`/${d.category}/`}>Browse {d.category}</a>
        <a href="/search/">Search all guides</a>
        <a href="/editorial-policy/">How we verify guides</a>
      </div>
    </aside>
  </div>
</BaseLayout>

<style is:global>
  .article-body a {
    color: var(--brand);
    font-weight: 650;
    text-decoration-line: underline;
    text-decoration-thickness: 0.08em;
    text-decoration-color: color-mix(in srgb, var(--brand) 55%, transparent);
    text-underline-offset: 0.18em;
    transition: color .15s ease, text-decoration-color .15s ease, background-color .15s ease;
  }

  .article-body a:hover {
    color: color-mix(in srgb, var(--brand) 78%, var(--ink));
    text-decoration-color: currentColor;
    background: var(--brand-soft);
  }

  .article-body a:focus-visible {
    outline: 3px solid var(--brand-soft);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .article-body a[href^="http"]::after {
    content: " ↗";
    font-size: .78em;
    font-weight: 800;
    text-decoration: none;
  }
</style>
