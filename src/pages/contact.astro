---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact DigiPlain" description="Contact DigiPlain about corrections, partnerships or editorial questions.">
  <section class="page-hero container"><span class="eyebrow">Contact</span><h1>Tell us what needs attention.</h1><p>For corrections, editorial questions, rights concerns or business enquiries, email us.</p></section>
  <section class="section" style="padding-top:20px"><div class="reading"><div class="card"><h2 style="font-size:1.6rem">Email</h2><p class="muted" style="margin:10px 0 0">hello@digiplain.com</p><p class="muted" style="margin:10px 0 0">This address is a launch placeholder until the DigiPlain domain mailbox is configured.</p></div></div></section>
</BaseLayout>
