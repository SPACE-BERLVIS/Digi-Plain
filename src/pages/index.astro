---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';

const articles = (await getCollection('articles', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.updatedAt.valueOf() - a.data.updatedAt.valueOf());

const featured = articles.filter((article) => article.data.featured);
const lead = featured[0] || articles[0];
const secondaryPool = [
  ...featured.slice(1),
  ...articles.filter((article) => article.data.slug !== lead?.data.slug),
];
const secondary = Array.from(
  new Map(secondaryPool.map((article) => [article.data.slug, article])).values(),
).slice(0, 3);

const excludedSlugs = new Set<string>();
if (lead) excludedSlugs.add(lead.data.slug);
secondary.forEach((article) => excludedSlugs.add(article.data.slug));
const recent = articles.filter((article) => !excludedSlugs.has(article.data.slug)).slice(0, 6);

const topics = [
  { name:'Phones', path:'/phones/', copy:'Device fixes and settings', label:'01', tone:'phones' },
  { name:'Apps', path:'/apps/', copy:'Everyday software guides', label:'02', tone:'apps' },
  { name:'Internet', path:'/internet/', copy:'Data, Wi-Fi and networks', label:'03', tone:'internet' },
  { name:'Nigeria', path:'/nigeria/', copy:'Local digital processes', label:'04', tone:'nigeria' },
  { name:'Explained', path:'/explained/', copy:'Confusing ideas made clear', label:'05', tone:'explained' },
];

const searchExamples = [
  ['MTN data balance', 'MTN data balance'],
  ['WhatsApp not downloading', 'WhatsApp not downloading'],
  ['Phone storage full', 'phone storage full'],
];

const readMinutes = (article: typeof articles[number]) => {
  const words = (article.body || '').trim().split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.ceil(words / 220));
};

const leadHasManualImage = Boolean(lead?.data.featuredImage);
const leadCover = lead ? lead.data.featuredImage || `/covers/${lead.data.slug}.svg` : '';
const leadCoverAlt = lead ? lead.data.featuredImageAlt || `DigiPlain cover for ${lead.data.title}` : '';

const orgSchema = {
  '@context':'https://schema.org',
  '@type':'Organization',
  name:'DigiPlain',
  url: Astro.site?.toString() || 'https://digiplain.invalid',
  description:'Clear, verified guides for phones, apps, internet services and everyday digital life.'
};
---
<BaseLayout structuredData={orgSchema}>
  <section class="hero hero-editorial">
    <div class="container hero-inner">
      <div class="hero-main">
        <div class="eyebrow">Digital life, made simple</div>
        <h1>Find the answer.<br/><span>Get on with your day.</span></h1>
        <p class="hero-copy">Clear, practical answers for the phones, apps, networks and online services you use every day. Written to solve the problem before wasting your time.</p>
        <form class="hero-search" action="/search/" method="get" role="search">
          <input type="search" name="q" placeholder="What are you trying to fix?" aria-label="Search DigiPlain" />
          <button type="submit">Search guides</button>
        </form>
        <div class="search-examples" aria-label="Popular searches">
          <span>Try:</span>
          {searchExamples.map(([label, query]) => <a href={`/search/?q=${encodeURIComponent(query)}`}>{label}</a>)}
        </div>
      </div>
      <aside class="hero-note">
        <span class="eyebrow">The DigiPlain standard</span>
        <strong>Answer first.</strong>
        <p class="muted">No long introductions before the solution. Changing guides show when they were updated or verified.</p>
        <a class="text-link" href="/editorial-policy/">How we verify guides <span aria-hidden="true">↗</span></a>
      </aside>
    </div>
  </section>

  <section class="topic-strip-section" aria-label="Browse DigiPlain categories">
    <div class="container topic-strip">
      {topics.map((topic) => (
        <a class:list={['topic-strip-item', `topic-strip-item--${topic.tone}`]} href={topic.path}>
          <span class="topic-index">{topic.label}</span>
          <span class="topic-strip-copy"><strong>{topic.name}</strong><small>{topic.copy}</small></span>
          <span class="topic-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  {lead && (
    <section class="section editorial-section">
      <div class="container">
        <div class="section-head section-head-rule">
          <div><span class="eyebrow">The front page</span><h2>Useful right now.</h2></div>
          <p class="muted">The most useful guide leads. The rest of the page behaves like an editorial desk, not an endless wall of identical cards.</p>
        </div>

        <div class="magazine-grid">
          <a class="lead-story" href={`/${lead.data.category}/${lead.data.slug}/`}>
            <div class:list={['lead-story-image', !leadHasManualImage && 'lead-story-image--generated']}>
              <img src={leadCover} alt={leadCoverAlt} loading="eager" fetchpriority="high" />
            </div>
            <div class="lead-story-copy">
              <div class="story-kicker"><span class="category-pill">{lead.data.category}</span><span>{lead.data.topic}</span></div>
              <h2>{lead.data.title}</h2>
              <p>{lead.data.description}</p>
              <div class="story-meta"><span>{readMinutes(lead)} min read</span><span>Updated {lead.data.updatedAt.toLocaleDateString('en-NG', { month:'short', day:'numeric', year:'numeric' })}</span></div>
            </div>
          </a>

          <div class="magazine-stack">
            {secondary.map((article) => <ArticleCard article={article} variant="compact" />)}
          </div>
        </div>
      </div>
    </section>
  )}

  {recent.length > 0 && (
    <section class="section latest-section">
      <div class="container">
        <div class="section-head section-head-rule">
          <div><span class="eyebrow">Recently updated</span><h2>Fresh answers.</h2></div>
          <a class="button secondary" href="/search/">View all guides</a>
        </div>
        <div class="latest-grid">
          {recent.map((article) => <ArticleCard article={article} variant="row" />)}
        </div>
      </div>
    </section>
  )}

  <section class="section manifesto-section">
    <div class="container manifesto-grid">
      <div>
        <span class="eyebrow">Why DigiPlain exists</span>
        <h2>The internet has enough content. It needs clearer answers.</h2>
      </div>
      <div class="manifesto-copy">
        <p>We focus on questions people actually type when something is confusing, broken or unfamiliar. Guides prioritize the direct answer, exact steps, troubleshooting and official sources when a process can change.</p>
        <a class="button" href="/editorial-policy/">How we publish</a>
      </div>
    </div>
  </section>
</BaseLayout>
